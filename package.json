{
  "name": "enmori-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "backend:build": "tsc --project backend/tsconfig.json",
    "backend:start": "pnpm backend:build && node backend/dist/src/bootstrap/controlled-runtime.js",
    "backend:test": "node --test \"backend/dist/test/**/*.test.js\"",
    "backend:verify": "pnpm backend:build && pnpm backend:test",
    "backend:initialize:s2-demo": "pnpm backend:build && node backend/dist/src/event-recommendations/infrastructure/run-s2-demo-initializer.js",
    "backend:emulator:test": "node backend/scripts/run-emulator-tests.mjs",
    "backend:verify:emulator": "pnpm backend:build && firebase emulators:exec --project demo-enmori-rmvp01a-r10 --only auth,firestore --config firebase.json \"pnpm backend:emulator:test\""
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "fastify": "5.12.1",
    "firebase-admin": "14.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "firebase-tools": "15.29.0",
    "typescript": "7.0.2"
  }
}
