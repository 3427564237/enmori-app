          "conversationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "recallPossible": {
            "type": "boolean",
            "const": false
          }
        },
        "description": "Owner-authorized status only. Accepted means provider accepted, not delivered or read. No source body, sourceMessageId, grant, routing value or authority proof is exposed."
      },
      "Intents": {
        "type": "object",
        "additionalProperties": false,
