                      "window"
                    ]
                  },
                  "startMinute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439
                  },
                  "endMinute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439
                  }
                }
              }
            ],
            "description": "A window must have distinct startMinute and endMinute; semantic equality is rejected with 422."
          },
          "maximumInRolling24h": {
            "type": "integer",
            "const": 1
          },
          "cooldownMinutes": {
            "type": "integer",
            "const": 480
          },
          "pushEnabled": {
            "type": "boolean"
          },
          "preview": {
            "type": "string",
            "enum": [
              "generic",
              "hidden"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "pausedUntil"
              ]
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "paused"
                }
              }
            }
          }
        ]
      },
      "CreateIntent": {
