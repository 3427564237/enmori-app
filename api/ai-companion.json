                "explicit_follow_up"
              ]
            }
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Explicit confirmed IANA time zone, validated against zone rules; no implicit device offset."
          },
          "quiet": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
