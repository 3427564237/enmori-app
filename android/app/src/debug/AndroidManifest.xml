<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Firebase Auth Emulator is HTTP-only on the Android host-loopback alias.
         Keep this exception debug-only and restricted to that exact address. -->
    <application android:networkSecurityConfig="@xml/emulator_network_security_config" />
</manifest>
